	"scripts": {
		"build": "tauri build",
		"build:appstore": "tauri build --no-bundle --target universal-apple-darwin --config src-tauri/tauri.appstore.conf.json && tauri bundle --bundles app --target universal-apple-darwin --config src-tauri/tauri.appstore.conf.json",
		"build:prod": "tauri build --config src-tauri/tauri.prod.conf.json",
		"clean": "shx rm -rf target && shx rm -rf dist && shx rm -rf .tanstack && shx rm -rf .turbo && shx rm -rf node_modules",
		"install:clean": "pnpm run clean && pnpm install",
		"lint": "eslint .",
		"start:dev": "tauri dev",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"ui:build": "pnpm typecheck && vite build",
		"ui:start:dev": "vite dev",
		"update:latest": "pnpm update --latest"
	},
	"dependencies": {
		"@base-ui/react": "^1.7.0",
		"@repo/ui": "workspace:*",
