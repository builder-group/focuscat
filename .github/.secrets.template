# GitHub Actions secrets template

# release-signing environment
# Add these secrets to Settings -> Environments -> release-signing
APPLE_CERTIFICATE=<base64-from-p12>
APPLE_CERTIFICATE_PASSWORD=<password-from-p12-export>
APPLE_ID=<your-apple-id@email.com>
APPLE_PASSWORD=<app-specific-password>
APPLE_SIGNING_IDENTITY=<Developer ID Application: Name (TEAM_ID)>
APPLE_TEAM_ID=<10-char-team-id>
TAURI_SIGNING_PRIVATE_KEY=<contents-of-~/.tauri/focuscat.key>
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=<password-used-during-key-generation>
